# Local Gemma inference through Ollama. No cloud LLM API key is required.
LOCAL_LLM_MODEL=gemma4:e4b
OLLAMA_BASE_URL=http://127.0.0.1:11434
LOCAL_LLM_TIMEOUT=180

# Optional: preserve the project's Tavily research search.
# When empty, public PubMed abstracts are used without an API key.
TAVILY_API_KEY=

# MRI segmentation uses the verified MONAI checkpoint downloaded by start_local.sh.
INFERENCE_SHAPE=64,128,128
# MODEL_URL=https://example.com/compatible-checkpoint.pth
# FRONTEND_ORIGINS=http://127.0.0.1:5173
